{
  "name": "cerebro-os",
  "version": "1.0.0",
  "private": true,
  "description": "Cerebro OS \u2014 buildless neuroscience research workspace, with a zero-dependency Node server that refuses OpenAI agents.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/server.mjs",
    "dev": "PORT=4701 LOG=1 node server/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "gen:hosts": "node scripts/gen-host-configs.mjs",
    "check:hosts": "node scripts/gen-host-configs.mjs --check",
    "refresh:openai": "node scripts/refresh-openai-ranges.mjs",
    "fetch:models": "node scripts/fetch-models.mjs",
    "test:models": "node scripts/test-models.mjs",
    "vendor:onnxruntime": "node scripts/vendor-onnxruntime.mjs"
  }
}
